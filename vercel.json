{
  "buildCommand": "pip install -r requirements.txt && python TweetProject/manage.py migrate && python TweetProject/manage.py collectstatic --noinput",
  "outputDirectory": "staticfiles",
  "env": {
    "PYTHON_VERSION": "3.11"
  },
  "functions": {
    "TweetProject/wsgi.py": {
      "memory": 3008,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "TweetProject/wsgi.py"
    }
  ]
}
